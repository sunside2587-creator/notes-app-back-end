              "    pm.expect(pm.response.json()).to.be.an('object');\r",
              "});\r",
              "\r",
              "pm.test('Body memiliki properti dan tipe data yang sesuai', () => {\r",
              "    const responseJson = pm.response.json();\r",
              "\r",
              "    pm.expect(responseJson).to.have.property('status');\r",
              "    pm.expect(responseJson.status).to.be.a('string');\r",
              "\r",
              "    pm.expect(responseJson).to.have.property('data');\r",
              "    pm.expect(responseJson.data).to.be.an('object');\r",
              "\r",
              "    pm.expect(responseJson.data).to.have.property('notes');\r",
              "    pm.expect(responseJson.data.notes).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test('Array notes memiliki minimal 1 item', () => {\r",
              "    const responseJson = pm.response.json();\r",
              "\r",
              "    pm.expect(responseJson.data.notes).to.have.lengthOf.at.least(1);\r",
              "});"
