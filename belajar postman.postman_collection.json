    {
      "name": "update catatan",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('expectedTitle', 'Judul terbaru');\r",
              "pm.collectionVariables.set('expectedBody', 'Isi catatan terbaru');\r",
              "pm.collectionVariables.set('expectedTags', JSON.stringify(['tag-baru']));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseJson = pm.response.json();\r",
              "\r",
              "pm.test('Status code harus 200', () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test('Content-Type harus application/json', () => {\r",
              "  pm.expect(pm.response.headers.get('Content-Type'))\r",
              "    .to.include('application/json');\r",
              "});\r",
              "\r",
              "pm.test('Response body harus berupa object', () => {\r",
              "  pm.expect(responseJson).to.be.an('object');\r",
              "});\r",
              "\r",
              "pm.test('Response memiliki properti status dan data', () => {\r",
              "  pm.expect(responseJson).to.have.property('status');\r",
              "  pm.expect(responseJson.status).to.be.a('string');\r",
              "\r",
              "  pm.expect(responseJson).to.have.property('data');\r",
              "  pm.expect(responseJson.data).to.be.an('object');\r",
              "});\r",
              "\r",
              "pm.test('Catatan yang dikembalikan memiliki nilai terbaru', () => {\r",
              "  const note = responseJson.data.note;\r",
              "\r",
              "  pm.expect(note).to.be.an('object');\r",
              "  pm.expect(note.title).to.eql(pm.collectionVariables.get('expectedTitle'));\r",
              "  pm.expect(note.body).to.eql(pm.collectionVariables.get('expectedBody'));\r",
              "  pm.expect(note.tags).to.eql(\r",
              "    JSON.parse(pm.collectionVariables.get('expectedTags'))\r",
              "  );\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
